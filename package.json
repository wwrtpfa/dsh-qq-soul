{
  "name": "dsh-qq-soul",
  "version": "1.2.0",
  "description": "懂你的QQ大肥鱼：住在 QQ 里的 AI 伙伴「大肥鱼」—— DeepSeek Harness 插件（经 NapCat / SnowLuma，OneBot v11 接 QQ）",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "src/host.js",
  "exports": {
    ".": "./src/host.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "package": "node scripts/package.mjs",
    "package:verify": "node scripts/package.mjs --verify",
    "service:check": "python -m services --check-deps",
    "service:serve": "python -m services --serve"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "qq",
    "onebot",
    "napcat",
    "qq-soul"
  ],
  "files": [
    "src",
    "client",
    "services",
    "models.json",
    "personas",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "docs/USER-MANUAL.md",
    "docs/MODULE-TUTORIAL.md",
    "docs/INSTALL-WITH-AI.md",
    "docs/prototype/index.html",
    "LICENSE",
    "NOTICE.md",
    "THIRD-PARTY-NOTICES.md",
    "CHANGELOG.md",
    "README_EN.md",
    "docs/DESIGN.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  }
}
